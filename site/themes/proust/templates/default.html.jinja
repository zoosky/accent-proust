{# A plain prose page. Nothing on this site uses it today -- home, docs and the
   playground all have templates of their own -- but a `default.html.jinja` is
   the template Accent falls back to for any page whose frontmatter names none,
   so it exists to make a new page render sensibly rather than fail. #}
{% extends "base.html.jinja" %}

{% block body %}
<div class="container docs-layout" style="grid-template-columns: minmax(0, 1fr)">
  <article class="docs-main">
    <header>
      <h1>{{ page.title }}</h1>
      {% if page.lead %}<p class="lead">{{ page.lead }}</p>{% endif %}
    </header>

    <div class="prose">
      {{ page.content | safe }}
    </div>
  </article>
</div>
{% endblock %}
