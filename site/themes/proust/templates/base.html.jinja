{# The shell every page shares.

   The navigation is written out rather than looped over `pages`, because half
   of it leaves the site -- crates.io, npm, docs.rs, GitHub -- and a loop that
   has to be pieced back together with a hand-written tail is longer than the
   list it replaces. Four links do not need a data structure. #}
<!DOCTYPE html>
<html lang="{{ page.language or 'en' }}" dir="{{ page.direction or 'ltr' }}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.title and page.title != site.name %}{{ page.title }} - {% endif %}{{ site.name }}</title>
  {# The browser paints the page background before any CSS arrives; without
     this the first frame of a dark page is white. It names both schemes
     because the stylesheet supports both. #}
  <meta name="color-scheme" content="dark light">

  {# Applied before the stylesheet so a reader who chose light does not get a
     frame of dark first. This is the one script here that has to be inline and
     blocking: a deferred one runs after first paint, which is exactly the
     flash it exists to prevent. Wrapped in try/catch because a browser with
     site data blocked throws on `localStorage` rather than returning null, and
     a theme preference is not worth a blank page. #}
  <script>
    try {
      var t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") {
        document.documentElement.setAttribute("data-theme", t);
      }
    } catch (e) {}
  </script>

  {# The Accent mark, copied byte-for-byte from the design system in
     accentcms/site-brand. The link order and the `mask-icon` colour match the
     Accent docs site, so the family shares one tab icon rather than one that
     merely looks similar. #}
  <link rel="icon" type="image/x-icon" href="{{ url('/theme/assets/favicon.ico') }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ url('/theme/assets/favicon-32x32.png') }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ url('/theme/assets/favicon-16x16.png') }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ url('/theme/assets/apple-touch-icon.png') }}">
  <link rel="mask-icon" href="{{ url('/theme/assets/safari-pinned-tab.svg') }}" color="#FF4F3E">

  {% include "partials/head_meta.html.jinja" %}
  {% for css in theme.assets.css %}
  <link rel="stylesheet" href="{{ url('/theme/assets/' ~ css) }}">
  {% endfor %}
  {% block head %}{% endblock %}
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container">
      <a class="wordmark" href="{{ url('/') }}">accent<span class="mark">-</span>proust</a>

      <nav class="site-nav" aria-label="Main">
        <a href="{{ url('/playground') }}" {% if page.url and '/playground' in page.url %}class="active"{% endif %}>Playground</a>
        <a href="{{ url('/docs') }}" {% if page.url and '/docs' in page.url %}class="active"{% endif %}>Docs</a>
        <a class="ext hide-sm" href="https://docs.rs/accent-proust">API</a>
        <a class="ext" href="https://github.com/zoosky/accent-proust">GitHub</a>

        <button type="button" class="icon-btn search-trigger" id="search-trigger"
                aria-label="Search" aria-expanded="false" aria-controls="search-overlay">
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
          <span class="label">Search</span>
          <kbd>/</kbd>
        </button>

        {# Not `aria-pressed`: this does not turn a setting on and off, it
           switches between two named themes. The label is rewritten by the
           script to name the one you get next. #}
        <button type="button" class="icon-btn theme-toggle" id="theme-toggle" aria-label="Switch theme">
          <svg class="icon-sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3.2"/><path d="M8 .8v1.8M8 13.4v1.8M15.2 8h-1.8M2.6 8H.8M13.09 2.91l-1.27 1.27M4.18 11.82l-1.27 1.27M13.09 13.09l-1.27-1.27M4.18 4.18 2.91 2.91"/></svg>
          <svg class="icon-moon" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main id="main">
    {% block body %}{% endblock %}
  </main>

  {# The `acms-search-*` class names are the generated search script's
     contract (`/_search/search.js`, produced by `accent build` from
     `search.backend` in config.yaml). It finds every `.acms-search-form`,
     reads `data-limit` and `data-search-backend` from it, and writes results
     into `.acms-search-results`. The dialog around them and the styling are
     this theme's; those three names are not ours to rename. #}
  <div id="search-overlay" hidden role="dialog" aria-modal="true" aria-label="Search this site">
    <div id="search-backdrop"></div>
    <div id="search-card">
      <div class="acms-search-form" data-search-backend="simple" data-limit="8">
        <div class="search-field">
          <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
          <input class="acms-search-input" type="search" placeholder="Search the documentation"
                 aria-label="Search this site" autocomplete="off" spellcheck="false">
        </div>
        <div class="acms-search-results"></div>
      </div>
      <p class="search-hint">
        <span><kbd>Enter</kbd> open</span>
        <span><kbd>Esc</kbd> close</span>
      </p>
    </div>
  </div>

  <footer class="site-footer">
    <div class="container">
      <div class="foot-grid">
        <div>
          <h2>accent-proust</h2>
          <p style="margin:0;max-width:34ch">
            A Rust implementation of the Markdoc language. MIT licensed, and a
            compatible reimplementation derived from the MIT-licensed Markdoc
            source.
          </p>
        </div>

        <div>
          <h2>Docs</h2>
          <ul>
            <li><a href="{{ url('/docs') }}">Overview</a></li>
            <li><a href="{{ url('/docs/rust') }}">Rust</a></li>
            <li><a href="{{ url('/docs/javascript') }}">JavaScript</a></li>
            <li><a href="{{ url('/docs/cli') }}">Command line</a></li>
            <li><a href="{{ url('/docs/language') }}">Markdoc</a></li>
            <li><a href="{{ url('/docs/architecture') }}">Architecture</a></li>
            <li><a href="{{ url('/docs/divergences') }}">Divergences</a></li>
          </ul>
        </div>

        <div>
          <h2>Packages</h2>
          <ul>
            <li><a href="https://crates.io/crates/accent-proust">crates.io</a></li>
            <li><a href="https://docs.rs/accent-proust">docs.rs</a></li>
            <li><a href="https://www.npmjs.com/package/accent-proust">npm</a></li>
          </ul>
        </div>

        <div>
          <h2>Project</h2>
          <ul>
            <li><a href="https://github.com/zoosky/accent-proust">Source</a></li>
            <li><a href="https://github.com/zoosky/accent-proust/blob/main/CHANGELOG.md">Changelog</a></li>
            <li><a href="https://github.com/zoosky/accent-proust/blob/main/LICENSE">Licence</a></li>
            <li><a href="https://markdoc.dev">Markdoc</a></li>
          </ul>
        </div>
      </div>

      <p class="colophon">
        Named for the strips of paper Proust glued into his manuscript to extend
        it -- parse, mutate, print, which is what a formatter does. Part of the
        <a href="https://accentcms.dev">Accent CMS</a> family, and built with it:
        these pages are rendered by Accent, and the playground is rendered by
        the engine this site documents.
      </p>
    </div>
  </footer>
  <script src="{{ url('/_search/search.js') }}" defer></script>
  <script src="{{ url('/theme/assets/js/chrome.js') }}" defer></script>
</body>

</html>
